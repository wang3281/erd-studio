# Example values only. Never commit a populated .env file.
NODE_ENV=development

EDIT_PASSWORD=[SET_LOCALLY]
ADMIN_PASSWORD=[SET_LOCALLY]

# Private is the safe default. Use public only for intentionally public schemas.
PROJECT_READ_ACCESS=private
EDITOR_SESSION_TTL_HOURS=8

# Production requires an https:// URL and COOKIE_SECURE=true.
APP_BASE_URL=http://localhost:5173
COOKIE_SECURE=false

DB_PATH=./erd.db
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

AI_PROVIDER=litellm
LITELLM_BASE_URL=[SET_LOCALLY]
LITELLM_API_KEY=[SET_LOCALLY]
LITELLM_MODEL=[SET_LOCALLY]
CODEX_MODEL=[SET_LOCALLY]

GITHUB_OAUTH_CLIENT_ID=[SET_LOCALLY]
GITHUB_OAUTH_CLIENT_SECRET=[SET_LOCALLY]
